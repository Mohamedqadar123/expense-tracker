{
  "name": "finance-tracker-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "recurring:run": "node scripts/runRecurringTransactions.js",
    "pretest": "docker compose -f docker-compose.test.yml up -d --wait && dotenv -e .env.test -- prisma migrate deploy",
    "test": "vitest run",
    "posttest": "docker compose -f docker-compose.test.yml down -v",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "vitest": "^3.2.4",
    "supertest": "^7.1.4",
    "dotenv-cli": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
