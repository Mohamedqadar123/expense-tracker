generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  emailVerifiedAt DateTime?

  // Every new account gets a free trial with every feature. After that the
  // app requires a paid plan ("standard" or "pro") that lasts until
  // paidUntil, which each approved Payment extends: mobile money has no
  // automatic recurring charge, so the subscription is prepaid period by
  // period. See services/subscription.js.
  trialEndsAt DateTime?
  paidPlan    String?
  paidUntil   DateTime?

  transactions          Transaction[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  recurringTransactions RecurringTransaction[]
  aiMessages            AiMessage[]
  accounts              Account[]
  authTokens            AuthToken[]
  payments              Payment[]
}

// A sign-up waiting for its email address to be confirmed. No User exists
// until the link sent to the address is opened; see utils/pendingSignups.js.
// Only the SHA-256 hash of the emailed token is stored.
model PendingSignup {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// Single-use, expiring tokens emailed to the user for email verification and
// password reset. Only the SHA-256 hash is stored, so a database leak does
// not expose usable links.
model AuthToken {
  id        Int      @id @default(autoincrement())
  type      String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  type        String
  category    String
  account     String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  recurringTransactionId Int?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  recurringLogs          RecurringTransactionLog[]

  @@index([userId])
  @@index([userId, date])
  @@index([userId, amount])
  @@index([userId, account])
  @@index([recurringTransactionId])
}

model RecurringTransaction {
  id                Int       @id @default(autoincrement())
  description       String
  amount            Float
  type              String
  category          String
  account           String?
  frequency         String
  status            String    @default("active")
  startDate         DateTime
  endDate           DateTime?
  nextExecutionDate DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  logs         RecurringTransactionLog[]

  @@index([userId])
  @@index([status, nextExecutionDate])
}

model RecurringTransactionLog {
  id                     Int      @id @default(autoincrement())
  recurringTransactionId Int
  recurringTransaction   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)
  occurrenceDate         DateTime
  status                 String   @default("generated")
  transactionId          Int?
  transaction            Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  message                String?
  createdAt              DateTime @default(now())

  @@unique([recurringTransactionId, occurrenceDate])
  @@index([recurringTransactionId])
}

model Budget {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  amount    Float
  period    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model AiMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A named money pool (e.g. "Bank", "EVC") with a starting balance the user
// saves once. Transactions reference it by name via Transaction.account
// (a plain string, not a foreign key, to stay backward-compatible with
// pre-existing free-text account values) — a transaction's current balance
// is startingBalance + sum(its income) - sum(its expenses), computed in
// accountBalances.js rather than stored, so it never drifts out of sync.
model Account {
  id              Int      @id @default(autoincrement())
  name            String
  startingBalance Float    @default(0)
  createdAt       DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model SavingsGoal {
  id           Int       @id @default(autoincrement())
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  targetDate   DateTime?
  createdAt    DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One attempt to charge a user's mobile wallet for a subscription period.
// referenceId is generated by us and sent to the payment provider, so a
// charge can always be traced back to this row.
model Payment {
  id                    Int      @id @default(autoincrement())
  provider              String
  plan                  String
  referenceId           String   @unique
  providerTransactionId String?
  phone                 String
  amount                Float
  currency              String
  status                String   @default("pending")
  message               String?
  createdAt             DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
