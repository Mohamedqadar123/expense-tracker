DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker?schema=public"
PORT=3001
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
# Set to "production" in real deployments — this gates the auth cookie's
# Secure flag (HTTPS-only transmission), among other environment-specific behavior.
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_string
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional. When unset, rate limiting uses in-memory storage, which is only
# correct with a single server process. Set this once you run more than one
# instance (e.g. behind a load balancer) so every instance shares the same
# rate-limit counters.
REDIS_URL=
