DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker?schema=public"
PORT=3001
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
# Set to "production" in real deployments — this gates the auth cookie's
# Secure flag (HTTPS-only transmission), among other environment-specific behavior.
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_string
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional. When unset, rate limiting uses in-memory storage, which is only
# correct with a single server process. Set this once you run more than one
# instance (e.g. behind a load balancer) so every instance shares the same
# rate-limit counters.
REDIS_URL=

# Public URL of the frontend, used for links in emails. Defaults to the first
# CORS_ORIGIN entry; with neither set (local development) links use this
# machine's local-network address so they also open on a phone on the same Wi-Fi.
APP_URL=http://localhost:5173

# Comma-separated emails of the accounts allowed to open the admin dashboard
# (/admin). The account must also have a verified email.
ADMIN_EMAILS=

# Price of each plan per 30-day period. Standard is everything except
# Finance AI; Pro adds Finance AI.
STANDARD_PRICE=5
PRO_PRICE=10
PLAN_CURRENCY=USD

# WaafiPay merchant credentials (EVC Plus / Zaad / Sahal payments). While
# these are unset the app runs normally but subscribing is disabled.
# Use https://sandbox.waafipay.net/asm as WAAFIPAY_API_URL for test payments.
WAAFIPAY_MERCHANT_UID=
WAAFIPAY_API_USER_ID=
WAAFIPAY_API_KEY=
WAAFIPAY_API_URL=https://api.waafipay.net/asm

# Verification and password-reset emails. Set EITHER the SMTP pair OR the
# Resend key; with neither, emails are printed to the server console instead.
#
# SMTP: for Gmail, SMTP_USER is the Gmail address and SMTP_PASS is a 16-character
# app password from https://myaccount.google.com/apppasswords (needs 2-Step
# Verification turned on). SMTP_HOST/SMTP_PORT default to Gmail's.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Resend (https://resend.com) API key, used only when SMTP is not set.
RESEND_API_KEY=
EMAIL_FROM="Finance Tracker <no-reply@yourdomain.com>"
